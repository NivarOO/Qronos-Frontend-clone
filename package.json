{
  "name": "qronos-mern",
  "version": "1.0.0",
  "private": true,
  "description": "Qronos MERN stack — Express + Mongoose API serving a React + Vite + Tailwind frontend",
  "scripts": {
    "install:all": "npm --prefix server install && npm --prefix client install",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "seed": "npm --prefix server run seed",
    "build": "npm --prefix client run build",
    "start": "NODE_ENV=production npm --prefix server run start",
    "typecheck": "npm --prefix client run typecheck",
    "make": "npm run install:all && npm run build",
    "all": "concurrently --kill-others-on-fail --names \"server,client\" --prefix-colors \"green,cyan\" \"npm run dev:server\" \"npm run dev:client\""
  },
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
